# Get your free Gemini API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_key_here
# Optional — defaults to gemini-3.8-flash. Change if Google retires the model.
GEMINI_MODEL=gemini-3.8-flash

# Supabase — get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth — get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Resend — transactional email for magic links (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here

# Public base URL of the app (used for magic link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
